# MerphisOS — Build Environment Container
# Folosește Podman/Docker pentru un mediu de build reproductibil

FROM debian:trixie-slim

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Build dependencies
RUN apt-get update && apt-get install -y \
    # Kernel build
    build-essential \
    bc \
    bison \
    flex \
    libssl-dev \
    libelf-dev \
    openssl \
    # ISO generation
    xorriso \
    grub-efi-amd64-bin \
    grub-pc-bin \
    mtools \
    dosfstools \
    debootstrap \
    squashfs-tools \
    isolinux \
    # Package signing
    gnupg \
    sbsigntool \
    # Testing
    qemu-system-x86 \
    qemu-utils \
    ovmf \
    # General
    curl \
    wget \
    git \
    ca-certificates \
    locales \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set locale
RUN sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && \
    sed -i '/ro_RO.UTF-8/s/^# //' /etc/locale.gen && \
    locale-gen

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Build user
RUN useradd -m -s /bin/bash builder && \
    echo "builder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /build
USER builder

CMD ["/bin/bash"]
